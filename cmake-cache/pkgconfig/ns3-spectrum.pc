exec_prefix="/usr/local/bin"
libdir="/usr/local/lib"
includedir="/usr/local/include"

Name: ns3-spectrum
Description: 
URL: 
Version: 3.48
Requires:  ns3-propagation ns3-antenna ns3-buildings
Requires.private: 
Cflags: -I"${includedir}"  -I/usr/include -I/usr/include/freetype2 -I/usr/include/glib-2.0 -I/usr/lib/x86_64-linux-gnu/glib-2.0/include -I/usr/include/gdk-pixbuf-2.0 -I/usr/include/gtk-3.0 -I/usr/include/cairo -I/usr/include/pango-1.0 -I/usr/include/harfbuzz -I/usr/include/atk-1.0 -I/usr/include/libxml2 -I/usr/include/python3.14
Libs: -L"${libdir}" -lns3.48-spectrum-default  -lns3.48-propagation-default -lns3.48-antenna-default -lns3.48-buildings-default -lstdc++exp
Libs.private: -L"${libdir}" 
