+Time
+QosFrameExchangeManager::GetStage2Window(uint8_t linkId) const
+{
+    // Placeholder combination; wire in real AIFS/slot accessors from your
+    // ChannelAccessManager/PhyEntity before running timing-sensitive experiments.
+    // See the build-order note: verify this against a PCAP before trusting it.
+    Time aifs = GetSifs() + m_edca->GetAifsn(linkId) * GetSlot();
+    Time backoffMargin = m_edca->GetMaxCw(linkId) * GetSlot();
+    Time winnerRtsCts = GetSifs() + GetRtsTxVector(m_edca->PeekNextMpdu(linkId)) /* placeholder */
+                             .GetPreambleAndHeaderDuration();
+    return aifs + backoffMargin + winnerRtsCts;
+}
+
+void
+QosFrameExchangeManager::SendDsCts(Ptr<QosTxop> edca, uint8_t linkId)
+{
+    NS_LOG_FUNCTION(this << edca << +linkId);
+
+    WifiMacHeader cts;
+    cts.SetType(WIFI_MAC_CTL_CTS);
+    cts.SetDsNotFrom();
+    cts.SetDsNotTo();
+    cts.SetNoRetry();
+    cts.SetNoMoreFragments();
+    cts.SetAddr1(DS_CTS_RA);
+
+    Time window = GetStage2Window(linkId);
+    cts.SetDuration(window);
+
+    // Step 3: PSRC only counts DS-CTS actually put on the air, never failed data
+    // attempts -- this call is the single increment point for the whole feature.
+    edca->IncrementPsrc(linkId);
+
+    Ptr<Packet> packet = Create<Packet>();
+    Ptr<WifiPsdu> psdu = Create<WifiPsdu>(Create<WifiMpdu>(packet, cts), true);
+
+    // Same TxVector source as CTS-to-self; the draft's DS-CTS rate may differ from
+    // your baseline's control rate -- check before trusting timing numbers.
+    WifiTxVector txVector = GetCtsToSelfTxVector();
+
+    // No ProtectionCompleted() and no response timer: this frame does not protect an
+    // upcoming data frame of ours, it opens the Stage-2 contention window for
+    // whichever P-EDCA STA wins next (possibly, but not necessarily, us).
+    m_phy->Send(psdu, txVector);
+
+    // Enter Stage 2 locally right away rather than waiting to "hear" our own DS-CTS;
+    // UpdateNav() below is what makes OTHER P-EDCA STAs enter Stage 2 upon reception.
+    edca->StartStage2(linkId);
+}
+
+void
+QosFrameExchangeManager::UpdateNav(Ptr<const WifiPsdu> psdu, const WifiTxVector& txVector)
+{
+    const auto& hdr = psdu->GetHeader(0);
+    if (hdr.IsCts() && hdr.GetAddr1() == DS_CTS_RA && m_mac->GetPEdcaSupported())
+    {
+        // P-EDCA STAs must NOT defer on this RA like a legacy station would; they
+        // either join Stage-2 contention (if eligible right now) or simply ignore it.
+        // PostProcessFrame() is the only caller of UpdateNav(), and Receive() already
+        // skips ReceiveMpdu() for frames whose RA is not ours, so this override is
+        // the complete receive-side hook -- no other function needs touching.
+        // NOTE: use AC_VO specifically, not whatever m_edca happens to be at this
+        // instant (m_edca tracks "whoever currently holds the channel" and is not
+        // necessarily AC_VO) -- P-EDCA in this draft is scoped to AC_VO only.
+        if (auto voTxop = m_mac->GetQosTxop(AC_VO); voTxop && voTxop->PedcaEligible(m_linkId))
+        {
+            voTxop->StartStage2(m_linkId);
+        }
+        return; // deliberately do NOT call the base class: no NAV set for us
+    }
+    FrameExchangeManager::UpdateNav(psdu, txVector); // legacy STAs, and any other CTS,
+                                                      // keep the normal behavior
+}

