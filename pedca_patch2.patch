+void
+QosTxop::StartStage2(uint8_t linkId)
+{
+    NS_LOG_FUNCTION(this << +linkId);
+    auto& s2 = GetStage2Entity(linkId);
+    if (s2.active)
+    {
+        return; // idempotent: already contending in this Stage-2 window
+    }
+    s2.active = true;
+
+    // Suspend every other AC on this link for the Stage-2 window. Reuse the existing
+    // MU-EDCA suspension primitive instead of touching ChannelAccessManager internals.
+    // GetLink(linkId).channelAccessManager and m_mac->GetQosTxop(ac) are the standard
+    // ns-3 lookups; wire up whichever accessor your ns-3.48 checkout exposes for the
+    // per-link ChannelAccessManager (GetLink(linkId).cam in most trees).
+    auto cam = GetLink(linkId).channelAccessManager; // Ptr<ChannelAccessManager>
+    // Pick a duration that safely covers the whole window: DSAIFSN + PEdcaCwMax slots,
+    // recomputed conservatively; refine once you have real slot/AIFS values wired in.
+    Time suspendFor = GetLink(linkId).aifsn.load; // placeholder -- see note in step 4 writeup
+    for (uint8_t ac = 0; ac < AC_BE_NQOS; ++ac)
+    {
+        if (static_cast<AcIndex>(ac) == m_ac)
+        {
+            continue;
+        }
+        if (auto other = m_mac->GetQosTxop(static_cast<AcIndex>(ac)); other)
+        {
+            cam->DisableEdcaFor(other, suspendFor);
+            s2.suspended.push_back(other);
+        }
+    }
+
+    // Switch this AC's own CW to the P-EDCA set and redraw backoff, mirroring the
+    // MU-EDCA entry sequence (GetMinCw/GetMaxCw/GetAifsn already branch on s2.active
+    // below, so this just forces a fresh draw against the new CW).
+    auto& link = GetLink(linkId);
+    link.cw = m_pedcaCwMin;
+    GenerateBackoff(linkId);
+
+    // Step 6 fallback: if nobody (including this STA) wins and the DS-CTS Duration
+    // expires with no successful RTS/CTS, force a clean exit so PSRC/eligibility can
+    // be re-evaluated on the next enqueue instead of the AC being stuck.
+    Time window = suspendFor; // Stage-2 window == the DS-CTS NAV duration by construction
+    s2.expiryEvent = Simulator::Schedule(window, &QosTxop::EndStage2, this, linkId,
+                                          PEDCA_WINDOW_EXPIRED);
+}
+
+void
+QosTxop::EndStage2(uint8_t linkId, PedcaExitReason reason)
+{
+    NS_LOG_FUNCTION(this << +linkId << reason);
+    auto it = m_stage2.find(linkId);
+    if (it == m_stage2.end() || !it->second.active)
+    {
+        return;
+    }
+    auto& s2 = it->second;
+    s2.active = false;
+    if (s2.expiryEvent.IsPending())
+    {
+        s2.expiryEvent.Cancel();
+    }
+
+    // Re-enable whatever this AC suspended. ChannelAccessManager::DisableEdcaFor is
+    // time-bounded, so most of the time this is a no-op by the time we get here; it
+    // only matters for the early-exit reasons (won/queue-empty/PSRC-limit), which
+    // fire before the scheduled suspension would have expired on its own.
+    auto cam = GetLink(linkId).channelAccessManager;
+    for (auto& other : s2.suspended)
+    {
+        cam->ReenableEdcaFor(other); // add this small helper next to DisableEdcaFor if
+                                     // your ns-3.48 tree does not already expose one
+    }
+    s2.suspended.clear();
+
+    // Restore standard EDCA CW for this AC. Do NOT call SetMinCw/SetMaxCw here --
+    // per the analysis, those setters call ResetCw() and would wipe QSRC, which must
+    // survive Stage-2 exit unless the exit reason is itself a successful ACK (handled
+    // separately in FrameExchangeManager::ReceivedNormalAck / DropMpduIfRetryLimitReached).
+    ResetCw(linkId); // CW itself is safe to reset: link.cw is recomputed from
+                     // GetMinCw()/GetMaxCw() on the next GenerateBackoff() call, and
+                     // those now read the normal (non-Stage-2) branch again.
+}
+
 uint8_t
 QosTxop::GetAifsn(uint8_t linkId) const
 {
+    if (IsInStage2(linkId))
+    {
+        return m_pedcaAifsn;
+    }
     if (m_muEdcaParameterSet && !EdcaDisabled(linkId) && GetLink(linkId).muEdcaTimer.IsRunning())
     {
         return GetLink(linkId).aifsn;
     }
     return GetLink(linkId).aifsn;
 }

