+    // P-EDCA: the Stage-2 winner must protect the channel with RTS/CTS before sending its
+    // FIRST data frame, regardless of what WifiRemoteStationManager::NeedRts() would otherwise
+    // decide (frame size, whether the destination is known to support it, etc.), since
+    // neighbouring legacy STAs have deferred on the DS-CTS's NAV rather than on an RTS/CTS
+    // exchange for this data frame specifically. Any further frames sent within the same
+    // Stage-2-won TXOP are already covered by the NAV that first frame's own Duration field
+    // set -- exactly like ordinary EDCA TXOP continuation frames for any other AC -- so
+    // ConsumePedcaStage2InitialFrame() only returns true once per Stage-2 win, not for every
+    // frame while IsPedcaStage2() happens to still be true.
+    bool pedcaNeedRts = false;
+    if (hdr.IsQosData() && QosUtilsMapTidToAc(hdr.GetQosTid()) == AC_VO)
+    {
+        auto voTxop = m_mac->GetQosTxop(AC_VO);
+        pedcaNeedRts = voTxop && voTxop->ConsumePedcaStage2InitialFrame(m_linkId);
+    }

     // check if RTS/CTS is needed
     if (emlsrNeedRts || pedcaNeedRts || GetWifiRemoteStationManager()->NeedRts(hdr, txParams))
